@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="swiper-container">
    <button type="button" class="nav-btn-prev" @onclick="() => ScrollAsync(-1)">
        <i class="bi bi-chevron-left"></i>
    </button>
    <div @ref="_content" class="d-flex flex-grow-1 align-items-center overflow-x-auto swiper-content">
        @foreach (var actor in Actors)
        {
            <ActorSwiperItem Actor="actor" />
        }
    </div>
    <button type="button" class="nav-btn-next" @onclick="() => ScrollAsync(1)">
        <i class="bi bi-chevron-right"></i>
    </button>
</div>

@code {
    [Parameter, EditorRequired]
    public List<Cast> Actors { get; set; } = [];

    private ElementReference _content;
    private IJSObjectReference? _module;

    private async Task ScrollAsync(int direction)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>(
            "import", "./Components/UI/ActorSwiper/ActorSwiper.razor.js");
        await _module.InvokeVoidAsync("scrollByAmount", _content, direction);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
